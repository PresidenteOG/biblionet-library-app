<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build-only: allows plaintext traffic to the Android emulator's loopback
  alias, which is where the local Firebase Auth/Firestore emulators listen
  (see BiblioNetApp.EMULATOR_ENABLED). Everything else keeps the platform
  default of TLS-only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
